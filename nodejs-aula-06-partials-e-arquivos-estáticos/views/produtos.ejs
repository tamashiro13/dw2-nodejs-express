    <!-- Chamando a variável para ser exibida na página -->
    <%#= produtos #%>

    <!-- Percorrendo a lista de produtos através do forEach: -->
     <% produtos.forEach(produto => { %>
        <p>Produto: <%= produto.nome %> </p>
        <p>Marca: <%= produto.marca %> </p>
        <p>Preço: <%= produto.preco %> </p>
     <% }); %>
